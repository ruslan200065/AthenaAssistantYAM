--- a/stations/yandexstation_2/hardware.rs
+++ b/stations/yandexstation_2/hardware.rs
@@ -2,10 +2,11 @@
 //!
 //! The board has no `station2:*:ring*` nodes that matter: the ring is a
 //! framebuffer (`fb0`, named "ring") of 89 pixels. The emulator exposes it at
-//! 24 bpp (three bytes per LED), while the firmware framebuffer is 32 bpp, so
-//! the backend follows `bits_per_pixel` and writes packed RGB or RGBX as the
-//! device expects. Writing four bytes into a three-byte framebuffer shifted
-//! every colour from the second LED on.
+//! 24 bpp (three bytes per LED), while the firmware framebuffer is 32 bpp RGBW,
+//! so the backend follows `bits_per_pixel` and writes packed RGB or RGBW as the
+//! device expects. The fourth byte is the white channel, not alpha. Writing
+//! four bytes into a three-byte framebuffer shifted every colour from the
+//! second LED on.
 //!
 //! The firmware and other indicators also paint this framebuffer. Luna only
 //! writes a blank framebuffer or one previously written by this backend.
@@ -72,16 +73,13 @@ impl Framebuffer {
     fn encode(&self, frame: &[u8]) -> Vec<u8> {
         let mut pixels = Vec::with_capacity(self.frame_bytes);
         for led in frame.chunks_exact(3) {
+            // Station 2's panel is RGBW32: the fourth byte is the white
+            // channel, not an unused alpha byte. Writing 0xff there makes
+            // every colour appear white, and swapping red/blue makes a red
+            // request appear blue. The first three bytes are plain RGB.
+            pixels.extend_from_slice(led);
             if self.bytes_per_pixel == 4 {
-                // Retail .50 FBIOGET_VSCREENINFO: R=16, G=8, B=0, A=24.
-                // Little-endian packed pixels therefore contain B, G, R, X.
-                pixels.extend_from_slice(&[led[2], led[1], led[0]]);
-            } else {
-                pixels.extend_from_slice(led);
-            }
-            // 32-bpp framebuffers keep one unused high byte per pixel.
-            if self.bytes_per_pixel == 4 {
-                pixels.push(0xff);
+                pixels.push(0x00);
             }
         }
         pixels
